<?xml version="1.0" encoding="utf-8"?>
<!-- NEXORA talks to a player-hosted server over plain HTTP/WS on a LAN, so cleartext is
     allowed for every host. TLS is still used automatically when the address starts with
     https:// or wss:// (see applyServerAddress in app.cpp). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
