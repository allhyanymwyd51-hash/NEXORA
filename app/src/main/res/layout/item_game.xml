<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_console"
    android:padding="10dp"
    android:layout_marginTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="R"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/tvGameName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Roblox"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/nexora_text" />

            <TextView
                android:id="@+id/tvGamePkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="com.roblox.client"
                android:textSize="10sp"
                android:textColor="@color/nexora_text_dim" />

            <TextView
                android:id="@+id/tvInstallState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مثبتة ✓"
                android:textSize="10sp"
                android:textColor="@color/nexora_green" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLaunch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="▶ تشغيل"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_text"
            android:background="@drawable/bg_button_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/btnUltraFps"
            android:layout_width="0dp"
            android:layout_weight="1.35"
            android:layout_height="42dp"
            android:text="⚡ ULTRA FPS"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_warn"
            android:background="@drawable/bg_choice"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/btnSharpness"
            android:layout_width="0dp"
            android:layout_weight="1.35"
            android:layout_height="42dp"
            android:text="◐ SHARPNESS"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/nexora_cyan"
            android:background="@drawable/bg_choice"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
</LinearLayout>
