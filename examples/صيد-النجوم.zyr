// لعبة زيرون 2D: صيد النجوم
// حرّك اللاعب بالأسهم أو بأزرار الشاشة
// اجمع ١٠ نجوم وتجنب الحارس!

خل اللاعب_س يكون ٤٨٠؛
خل اللاعب_ص يكون ٢٧٠؛
خل سرعة_اللاعب يكون ٢٧٠؛
خل نجمة_س يكون ٢٤٠؛
خل نجمة_ص يكون ١٤٠؛
خل الحارس_س يكون ١٠٠؛
خل الحارس_ص يكون ٣٤٠؛
خل سرعة_الحارس يكون ٩٠؛
خل النقاط يكون ٠؛
خل الأرواح يكون ٣؛
خل حماية يكون ٠؛
خل انتهت يكون غلط؛

خلفية("#10162d")؛

// هذي السالفة تشتغل باستمرار؛ زمن هو الوقت بالثواني
سالفة حدث(زمن) {
  لو مو انتهت {
    لو مضغوط("يمين") { اللاعب_س يصير اللاعب_س + سرعة_اللاعب * زمن؛ }
    لو مضغوط("يسار") { اللاعب_س يصير اللاعب_س - سرعة_اللاعب * زمن؛ }
    لو مضغوط("فوق") { اللاعب_ص يصير اللاعب_ص - سرعة_اللاعب * زمن؛ }
    لو مضغوط("تحت") { اللاعب_ص يصير اللاعب_ص + سرعة_اللاعب * زمن؛ }

    // خلك داخل حدود الملعب
    لو اللاعب_س أقل من ٢٠ { اللاعب_س يصير ٢٠؛ }
    لو اللاعب_س أكبر من ٩٤٠ { اللاعب_س يصير ٩٤٠؛ }
    لو اللاعب_ص أقل من ٢٠ { اللاعب_ص يصير ٢٠؛ }
    لو اللاعب_ص أكبر من ٥٢٠ { اللاعب_ص يصير ٥٢٠؛ }

    // اجمع النجمة ثم انقلها لمكان جديد
    لو يتلامس(اللاعب_س - ٢٠، اللاعب_ص - ٢٠، ٤٠، ٤٠، نجمة_س - ١٨، نجمة_ص - ١٨، ٣٦، ٣٦) {
      النقاط يصير النقاط + ١؛
      نجمة_س يصير عشوائي(٥٠، ٩١٠)؛
      نجمة_ص يصير عشوائي(٧٠، ٤٨٠)؛
    }

    // سلوك بسيط: الحارس يلاحق اللاعب (ليس نموذج تعلم آلي)
    لو اللاعب_س أكبر من الحارس_س { الحارس_س يصير الحارس_س + سرعة_الحارس * زمن؛ }
    لو اللاعب_س أقل من الحارس_س { الحارس_س يصير الحارس_س - سرعة_الحارس * زمن؛ }
    لو اللاعب_ص أكبر من الحارس_ص { الحارس_ص يصير الحارس_ص + سرعة_الحارس * زمن؛ }
    لو اللاعب_ص أقل من الحارس_ص { الحارس_ص يصير الحارس_ص - سرعة_الحارس * زمن؛ }
    لو حماية أكبر من ٠ { حماية يصير حماية - زمن؛ }

    لو حماية <= ٠ و يتلامس(اللاعب_س - ٢٠، اللاعب_ص - ٢٠، ٤٠، ٤٠، الحارس_س - ٢٥، الحارس_ص - ٢٥، ٥٠، ٥٠) {
      الأرواح يصير الأرواح - ١؛
      حماية يصير ١.٥؛
    }
    لو الأرواح <= ٠ { انتهت يصير صح؛ }
    لو النقاط >= ١٠ { انتهت يصير صح؛ }
  }
}

// رسم الملعب في كل إطار
سالفة ارسم() {
  مستطيل(٠، ٤٨، ٩٦٠، ٢، "#263654")؛
  دائرة(نجمة_س، نجمة_ص، ١٨، "#ffd66b")؛
  مستطيل(الحارس_س - ٢٥، الحارس_ص - ٢٥، ٥٠، ٥٠، "#ff698a")؛
  دائرة(اللاعب_س، اللاعب_ص، ٢٠، "#a78bfa")؛

  اكتب_على_الشاشة("النجوم:", ٩٢٠، ٣٤، ٢٣، "#ffffff")؛
  اكتب_على_الشاشة(النقاط، ٨١٠، ٣٤، ٢٣، "#ffd66b")؛
  اكتب_على_الشاشة("الأرواح:", ٢٢٠، ٣٤، ٢٣، "#ffffff")؛
  اكتب_على_الشاشة(الأرواح، ٩٠، ٣٤، ٢٣، "#ff698a")؛

  لو انتهت {
    مستطيل(١٨٠، ١٦٠، ٦٠٠، ٢٠٠، "#1d2240")؛
    لو النقاط >= ١٠ {
      اكتب_على_الشاشة("كفو! جمعت كل النجوم", ٧٢٠، ٢٤٠، ٣٦، "#ffd66b")؛
    } غير كذا {
      اكتب_على_الشاشة("انتهت اللعبة.. حاول من جديد", ٧٤٠، ٢٤٠، ٣٢، "#ff698a")؛
    }
    اكتب_على_الشاشة("اضغط إعادة لتلعب مرة ثانية", ٧٢٠، ٣٠٥، ٢٣، "#ffffff")؛
  }
}

وقت_التحديث(حدث)؛
وقت_الرسم(ارسم)؛
